<Project Sdk="Microsoft.NET.Sdk">
  <!-- On-demand conversion process. Decodes, encodes and validates with Windows Imaging Component; one JSON line per job.
       It also renders PDFs with the bundled PDFium (ADR-0029): PDF to images and text, and the check of Images to PDF. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PdfiumDir>$(MSBuildThisFileDirectory)..\..\artifacts\engines\pdfium-8111\</PdfiumDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTools.Core\WinTools.Core.csproj" />
    <ProjectReference Include="..\WinTools.Worker.Common\WinTools.Worker.Common.csproj" />
    <PackageReference Include="SkiaSharp" />
    <InternalsVisibleTo Include="WinTools.Worker.Tests" />
    <!-- Equal to WorkerJobObject.WorkerMemoryLimitBytes (1536 MiB, ADR-0015). Set explicitly: the worker joins the host's
         job after it has started, and a GC that read the job's limit first would cap its heap at 75 % of it. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="1610612736" />
  </ItemGroup>
  <!-- PDFium, fetched and hash-checked by scripts\Get-Engines.ps1, in a folder of its own: loaded by full path only. -->
  <ItemGroup>
    <None Include="$(PdfiumDir)pdfium.dll" Link="pdfium\pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="RequirePdfium" BeforeTargets="Build" Condition="!Exists('$(PdfiumDir)pdfium.dll')">
    <Error Text="The PDF rendering engine is missing: run scripts\Get-Engines.ps1 (it fetches PDFium chromium/8111 and checks its hash, ADR-0029)." />
  </Target>
</Project>
