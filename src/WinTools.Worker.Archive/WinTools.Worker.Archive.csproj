<Project Sdk="Microsoft.NET.Sdk">
  <!-- On-demand worker of the Archives module (V2 PR 5.1, ADR-0023): ZIP extract, test, info and create with .NET's own
       System.IO.Compression. No third-party code. One JSON line per job, like the other workers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTools.Core\WinTools.Core.csproj" />
    <ProjectReference Include="..\WinTools.Worker.Common\WinTools.Worker.Common.csproj" />
    <InternalsVisibleTo Include="WinTools.Worker.Tests" />
  </ItemGroup>
</Project>
