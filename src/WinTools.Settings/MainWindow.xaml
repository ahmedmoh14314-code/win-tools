<Window x:Class="WinTools.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinTools.Settings"
        Title="WinTools" Width="940" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Base}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="Assets/WinTools.ico">
  <Grid>
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Side navigation -->
      <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,20,14,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
            <Image Source="Assets/WinTools.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WinTools" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Hint}" Margin="0" FontSize="11" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="NavVersion" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="8,0,0,0" />
          <StackPanel>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav" Content="{l:T nav.home}" IsChecked="True" />
            <RadioButton x:Name="NavHowTo" Style="{StaticResource NavItem}" GroupName="Nav" Content="{l:T nav.howto}" />
            <RadioButton x:Name="NavFeatures" Style="{StaticResource NavItem}" GroupName="Nav" Content="{l:T nav.features}" />
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Content="{l:T nav.settings}" />
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav" Content="{l:T nav.about}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Pages -->
      <Grid Grid.Column="1">
        <!-- Home -->
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Padding="36,30,36,24" Focusable="False">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="22,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0">
                  <TextBlock x:Name="HostState" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="HomeTrigger" Style="{StaticResource Hint}" FontSize="13" />
                </StackPanel>
                <Button x:Name="StartHost" Grid.Column="2" Style="{StaticResource Accent}" Content="{l:T home.start}" Visibility="Collapsed" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock x:Name="HomeHint" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,26,0,8" />
            <l:FlowSteps x:Name="HomeSteps" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <Button x:Name="HomeHowTo" Style="{StaticResource Accent}" Content="{l:T home.openHowTo}" Margin="0,0,10,0" />
              <Button x:Name="HomeSettings" Content="{l:T home.openSettings}" Padding="18,7" />
            </StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T home.worksWith}" Margin="2,30,0,10" />
            <WrapPanel x:Name="Families" />
          </StackPanel>
        </ScrollViewer>

        <!-- How to use -->
        <ScrollViewer x:Name="HowToPage" VerticalScrollBarVisibility="Auto" Padding="36,30,36,24" Focusable="False" Visibility="Collapsed">
          <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T howto.title}" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{l:T howto.intro}" />
            <l:FlowSteps x:Name="HowToSteps" Detailed="True" Margin="0,22,0,0" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T howto.groups}" Margin="2,26,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,12">
              <StackPanel>
                <TextBlock Text="{l:T howto.convert}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T howto.convert.text}" />
                <TextBlock Text="{l:T howto.tools}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T howto.tools.text}" />
                <TextBlock Text="{l:T howto.actions}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T howto.actions.text}" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T howto.only}" Margin="0,14,0,6" />
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T howto.keys}" Margin="2,22,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,14">
              <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{l:T howto.keys.text}" />
            </Border>
            <Button x:Name="ShowTour" Content="{l:T howto.tour}" HorizontalAlignment="Left" Padding="16,7" Margin="0,22,0,0" />
          </StackPanel>
        </ScrollViewer>

        <!-- Features -->
        <ScrollViewer x:Name="FeaturesPage" VerticalScrollBarVisibility="Auto" Padding="36,30,36,24" Focusable="False" Visibility="Collapsed">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T features.title}" />
            <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{l:T features.intro}" />
            <StackPanel x:Name="FeatureList" Margin="0,10,0,0" />
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="36,30,36,4">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T settings.title}" />
            <TextBlock x:Name="Status" Style="{StaticResource Hint}" Text="{l:T settings.saved}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,36,24" Focusable="False">
            <StackPanel x:Name="Sections" MaxWidth="640" HorizontalAlignment="Left">
              <Border x:Name="ReadOnlyBanner" Visibility="Collapsed" Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="#2A2416" BorderBrush="{StaticResource Warning}" BorderThickness="1">
                <TextBlock x:Name="ReadOnlyText" TextWrapping="Wrap" Foreground="{StaticResource Warning}" />
              </Border>

              <!-- General -->
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T settings.general}" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.language}" />
                      <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.language.hint}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="170" Height="32" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.language}" />
                  </Grid>
                  <Border Height="1" Background="{StaticResource Edge}" />
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.trigger}" />
                      <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.trigger.hint}" />
                      <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.trigger.why}" />
                    </StackPanel>
                    <ComboBox x:Name="TriggerKey" Grid.Column="1" Width="120" Height="32" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.trigger}" />
                  </Grid>
                  <Border Height="1" Background="{StaticResource Edge}" />
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.sounds}" />
                      <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.sounds.hint}" />
                    </StackPanel>
                    <CheckBox x:Name="UiSounds" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.sounds}" />
                  </Grid>
                  <Border Height="1" Background="{StaticResource Edge}" />
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.startup}" />
                      <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Text="{l:T settings.startup.hint}" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindows" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.startup}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Output -->
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T settings.output}" />
              <Border Style="{StaticResource Card}">
                <StackPanel Margin="0,10">
                  <TextBlock Text="{l:T settings.output.where}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.output.hint}" />
                  <RadioButton x:Name="SameFolder" GroupName="Output" Content="{l:T settings.output.same}" Margin="0,12,0,0" />
                  <RadioButton x:Name="CustomFolder" GroupName="Output" Content="{l:T settings.output.folder}" Margin="0,10,0,0" />
                  <Grid Margin="28,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPath" Height="32" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.Name="{l:T settings.output.folder}" />
                    <Button x:Name="Browse" Grid.Column="1" Content="{l:T settings.output.browse}" Margin="8,0,0,0" Height="32" />
                  </Grid>
                  <TextBlock x:Name="FolderError" Style="{StaticResource Hint}" Foreground="{StaticResource Warning}" Margin="28,6,0,0" Visibility="Collapsed" />
                </StackPanel>
              </Border>

              <!-- Images -->
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T settings.images}" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T settings.jpeg}" VerticalAlignment="Center" />
                    <Slider x:Name="JpegQuality" Grid.Column="1" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.jpeg}" />
                    <TextBlock x:Name="JpegValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T settings.webp}" VerticalAlignment="Center" />
                    <Slider x:Name="WebPQuality" Grid.Column="1" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.webp}" />
                    <TextBlock x:Name="WebPValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.quality.hint}" Margin="0,0,0,8" />
                  <Border Height="1" Background="{StaticResource Edge}" />
                  <StackPanel Margin="0,10">
                    <TextBlock Text="{l:T settings.resize}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.resize.hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <TextBox x:Name="ResizeWidth" Width="86" Height="32" HorizontalContentAlignment="Center" AutomationProperties.Name="Width" />
                      <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                      <TextBox x:Name="ResizeHeight" Width="86" Height="32" HorizontalContentAlignment="Center" AutomationProperties.Name="Height" />
                      <TextBlock Text="px" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                    <TextBlock x:Name="SizeError" Style="{StaticResource Hint}" Foreground="{StaticResource Warning}" Visibility="Collapsed" />
                    <CheckBox x:Name="KeepAspect" Content="{l:T settings.aspect}" Margin="0,12,0,0" />
                    <CheckBox x:Name="NoUpscale" Content="{l:T settings.noUpscale}" Margin="0,10,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Appearance -->
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T settings.appearance}" />
              <Border Style="{StaticResource Card}">
                <StackPanel Margin="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.theme}" />
                      <TextBlock Style="{StaticResource Hint}" Text="{l:T settings.theme.hint}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{l:T settings.theme.dark}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                  <Border Height="1" Background="{StaticResource Edge}" Margin="0,12,0,0" />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{l:T settings.animations}" />
                      <TextBlock x:Name="AnimationsHint" Style="{StaticResource Hint}" Text="{l:T settings.animations.hint}" />
                    </StackPanel>
                    <ComboBox x:Name="Animations" Grid.Column="1" Width="160" Height="32" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.animations}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Advanced -->
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T settings.advanced}" />
              <Border Style="{StaticResource Card}" Padding="18,14">
                <WrapPanel>
                  <Button x:Name="Reset" Content="{l:T settings.reset}" Margin="0,0,8,0" Padding="14,6" />
                  <Button x:Name="OpenLogs" Content="{l:T settings.logs}" Padding="14,6" />
                </WrapPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="36,10">
            <TextBlock x:Name="Footer" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>

        <!-- About -->
        <ScrollViewer x:Name="AboutPage" VerticalScrollBarVisibility="Auto" Padding="36,30,36,24" Focusable="False" Visibility="Collapsed">
          <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <Image Source="Assets/WinTools.ico" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14" />
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T about.title}" />
            <TextBlock x:Name="AboutVersion" Style="{StaticResource Hint}" FontSize="13" />
            <TextBlock Text="{l:T about.text}" TextWrapping="Wrap" Margin="0,16,0,0" />
            <TextBlock Text="{l:T about.safe}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button x:Name="Notices" Content="{l:T about.notices}" Padding="14,6" Margin="0,0,8,0" />
              <Button x:Name="AboutLogs" Content="{l:T about.logs}" Padding="14,6" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- First-run tour: over everything, until finished or skipped. -->
    <l:Onboarding x:Name="Tour" Visibility="Collapsed" />
  </Grid>
</Window>
