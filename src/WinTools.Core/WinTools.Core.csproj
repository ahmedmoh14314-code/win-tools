<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework-independent domain: interaction state machine, file identification, capabilities, output naming,
       worker contract. No Win32, no UI framework, no imaging engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier />
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinTools.Core.Tests" />
    <!-- The user-facing text in English and Arabic (UiText). -->
    <EmbeddedResource Include="Localization\Strings.*.json" LogicalName="WinTools.Core.Localization.%(Filename).json" WithCulture="false" />
  </ItemGroup>
</Project>
