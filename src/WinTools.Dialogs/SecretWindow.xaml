<Window x:Class="WinTools.Dialogs.SecretWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinTools.Dialogs"
        Width="320" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Background="{StaticResource Base}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border Padding="14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <StackPanel>
      <TextBlock x:Name="Heading" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" Margin="0,0,0,10" />
      <TextBlock Text="{l:T dialog.password}" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,4" />
      <PasswordBox x:Name="First" FontSize="14" Padding="6,4" AutomationProperties.Name="{l:T dialog.password}" />
      <StackPanel x:Name="ConfirmPanel">
        <TextBlock Text="{l:T dialog.passwordAgain}" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="12" Margin="0,10,0,4" />
        <PasswordBox x:Name="Second" FontSize="14" Padding="6,4" AutomationProperties.Name="{l:T dialog.passwordAgain}" />
      </StackPanel>
      <TextBlock x:Name="Problem" Foreground="{StaticResource Warning}" FontFamily="Segoe UI" FontSize="12" Margin="0,8,0,0"
                 TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock x:Name="Hint" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="Ok" Content="{l:T dialog.ok}" IsDefault="True" MinWidth="80" Padding="10,4" Margin="0,0,8,0" Click="OnOk" />
        <Button Content="{l:T dialog.cancel}" IsCancel="True" MinWidth="80" Padding="10,4" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
