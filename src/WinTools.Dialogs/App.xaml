<Application x:Class="WinTools.Dialogs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The product's dark palette (the same values as WinTools.Windows.Rendering.Palette and the settings window). -->
      <SolidColorBrush x:Key="Base" Color="#111714" />
      <SolidColorBrush x:Key="Surface" Color="#1D2621" />
      <SolidColorBrush x:Key="Raised" Color="#263129" />
      <SolidColorBrush x:Key="Edge" Color="#2C3832" />
      <SolidColorBrush x:Key="Green" Color="#22C55E" />
      <SolidColorBrush x:Key="Text" Color="#F4F7F5" />
      <SolidColorBrush x:Key="TextSecondary" Color="#9AA69F" />
      <SolidColorBrush x:Key="Warning" Color="#F5B54A" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
