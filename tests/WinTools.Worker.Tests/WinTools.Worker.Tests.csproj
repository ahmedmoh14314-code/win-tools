<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests: real image files through WIC in-process, the worker as a separate process, and the host's
       worker client (crash, timeout, cleanup). No desktop interaction; runs in CI. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\WinTools.Worker\WinTools.Worker.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Host\WinTools.Host.csproj" />
    <None Include="..\samples\*.png;..\samples\*.jpg;..\samples\*.bmp;..\samples\*.tif;..\samples\*.webp" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
