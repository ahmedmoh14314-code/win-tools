<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests: real image files through WIC in-process, the worker as a separate process, and the host's
       worker client (crash, timeout, cleanup). No desktop interaction; runs in CI. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\WinTools.Worker\WinTools.Worker.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Worker.Text\WinTools.Worker.Text.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Worker.Pdf\WinTools.Worker.Pdf.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Worker.Archive\WinTools.Worker.Archive.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Worker.Media\WinTools.Worker.Media.csproj" />
    <ProjectReference Include="..\..\src\WinTools.Host\WinTools.Host.csproj" />
    <!-- The dialogs process, started by its own tests as the host starts it. -->
    <ProjectReference Include="..\..\src\WinTools.Dialogs\WinTools.Dialogs.csproj" ReferenceOutputAssembly="false" Private="false" />
    <None Include="..\samples\*.png;..\samples\*.jpg;..\samples\*.bmp;..\samples\*.tif;..\samples\*.webp;..\samples\locked-*.zip" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyDialogsApp" AfterTargets="Build">
    <MSBuild Projects="..\..\src\WinTools.Dialogs\WinTools.Dialogs.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DialogsTarget" />
    </MSBuild>
    <PropertyGroup>
      <_DialogsDir>%(_DialogsTarget.RootDir)%(_DialogsTarget.Directory)</_DialogsDir>
    </PropertyGroup>
    <ItemGroup>
      <_DialogsFiles Include="$(_DialogsDir)WinTools.Dialogs.exe;$(_DialogsDir)WinTools.Dialogs.dll;$(_DialogsDir)WinTools.Dialogs.runtimeconfig.json;$(_DialogsDir)WinTools.Dialogs.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DialogsFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
